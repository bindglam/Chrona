From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mini-kio <kiolaaoz@naver.com>
Date: Sat, 17 Jan 2026 21:16:46 +0900
Subject: [PATCH] Fix setBlock intercept - fallback to vanilla if not captured


diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 2c9647b68ef2243c5b44458d13fbf2fed178ab23..acda091e08fa4ff15251df1fe19b3c2692b2175c 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -1061,7 +1061,10 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         // CraftBukkit end
         // Chrona start - intent system for setBlock
         if (org.wrd.chrona.config.ChronaConfig.asyncEnabled && this instanceof ServerLevel serverLevel) {
-            return org.wrd.chrona.tick.compat.BukkitCompatLayer.interceptSetBlock(serverLevel, pos, state, flags);
+            if (org.wrd.chrona.tick.compat.BukkitCompatLayer.interceptSetBlock(serverLevel, pos, state, flags)) {
+                return true; // Intent captured, will be applied in commit phase
+            }
+            // Fall through to vanilla logic if not intercepted
         }
         // Chrona end
         if (!this.isInValidBounds(pos)) {
